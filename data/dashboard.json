  "spiritual": {
    "come_follow_me": {
      "status": "ready",
      "week_of": "2026-10-19",
      "lesson": 43,
      "dates_label": "Oct 19–25",
      "title": "“Before I Formed Thee in the Belly I Knew Thee”",
      "reading": "Jeremiah 1–3; 7; 16–18; 20",
      "summary": "Jeremiah felt too young to be a prophet, but the Lord had known and ordained him before he was born and promised, “I am with thee.” Jesus is “the fountain of living waters,” and the Lord will gather His people “one of a city, and two of a family.”",
      "questions": [
        "What did Jeremiah learn about himself in Jeremiah 1:5, and how is it true for you too?",
        "What might the “broken cisterns” and the “fountain of living waters” stand for? (2:13)",
        "How can we help gather Heavenly Father’s children, like the fishers and hunters? (16:14–16)"
      ],
      "source_url": "https://www.churchofjesuschrist.org/study/manual/come-follow-me-for-home-and-church-old-testament-2026/43?lang=eng",
      "previous": {
        "show_before": "2026-10-19",
        "lesson": 42,
        "dates_label": "Oct 12–18",
        "title": "“The Redeemer Shall Come to Zion”",
        "reading": "Isaiah 58–66",
        "source_url": "https://www.churchofjesuschrist.org/study/manual/come-follow-me-for-home-and-church-old-testament-2026/42?lang=eng"
      },
      "featured_question": 0,
      "daily": [
        {
          "dow": "Mon",
          "scripture": "Jeremiah 1:5",
          "quote": "Before I formed thee in the belly I knew thee",
          "thought": "Heavenly Father knew each of us before we were born and has work for us to do. What strength has He given you?"
        },
        {
          "dow": "Tue",
          "scripture": "Jeremiah 1:6–8",
          "quote": "Be not afraid of their faces: for I am with thee",
          "thought": "Jeremiah felt too young, but the Lord promised to be with him. What hard thing can you try today with His help?"
        },
        {
          "dow": "Wed",
          "scripture": "Jeremiah 2:13",
          "quote": "they have forsaken me the fountain of living waters",
          "thought": "Jesus is a fountain that never runs dry. How can we drink from His living water today?"
        },
        {
          "dow": "Thu",
          "scripture": "Jeremiah 3:14–15",
          "quote": "I will take you one of a city, and two of a family, and I will bring you to Zion",
          "thought": "The Lord gathers His children one by one. Who can we include or invite this week?"
        },
        {
          "dow": "Fri",
          "scripture": "Jeremiah 16:16",
          "quote": "Behold, I will send for many fishers, saith the Lord",
          "thought": "President Nelson compared these fishers and hunters to missionaries. How can we help gather Israel?"
        },
        {
          "dow": "Sat",
          "scripture": "Jeremiah 18:6",
          "quote": "as the clay is in the potter’s hand, so are ye in mine hand",
          "thought": "The Lord shapes us like a potter shapes clay. What can we let Him help us change?"
        },
        {
          "dow": "Sun",
          "scripture": "Jeremiah 1:9",
          "quote": "Behold, I have put my words in thy mouth",
          "thought": "Prophets speak the Lord’s words. Share one thing you remember from the prophet at general conference."
        }
      ],
      "daily_note": "Mon–Sun queue for the CFM week (week_of); the v3 dashboard shows the item whose dow matches the iPad's date. Replace on the Saturday refresh."
    },
