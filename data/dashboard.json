  "spiritual": {
    "come_follow_me": {
      "status": "ready",
      "week_of": "2026-10-12",
      "lesson": 42,
      "dates_label": "Oct 12–18",
      "title": "“The Redeemer Shall Come to Zion”",
      "reading": "Isaiah 58–66",
      "summary": "Fasting brings spiritual power and blesses people in need, and the Sabbath can be “a delight” (Isa. 58). Jesus read Isaiah 61 in Nazareth to declare He is the Redeemer who gives “beauty for ashes.”",
      "questions": [
        "Why do we fast, and who can our fast offering help? (58:6–7)",
        "What would make Sunday more of “a delight” for us? (58:13–14)",
        "How has Jesus given us “beauty for ashes”? (61:1–3)"
      ],
      "source_url": "https://www.churchofjesuschrist.org/study/manual/come-follow-me-for-home-and-church-old-testament-2026/42?lang=eng",
      "previous": {
        "show_before": "2026-10-11",
        "lesson": 41,
        "dates_label": "Oct 5–11",
        "title": "“He Hath Borne Our Griefs, and Carried Our Sorrows”",
        "reading": "Isaiah 50–57",
        "source_url": "https://www.churchofjesuschrist.org/study/manual/come-follow-me-for-home-and-church-old-testament-2026/41?lang=eng"
      },
      "featured_question": 1,
      "daily": [
        {
          "dow": "Mon",
          "scripture": "Isaiah 58:6–7",
          "quote": "Is not this the fast that I have chosen? … to deal thy bread to the hungry",
          "thought": "Fasting isn’t just going without — it lifts heavy burdens and feeds people in need. Who can we help this week?"
        },
        {
          "dow": "Tue",
          "scripture": "Isaiah 58:8–9",
          "quote": "Then shall thy light break forth as the morning … thou shalt cry, and he shall say, Here I am.",
          "thought": "When we fast and serve, the Lord promises to answer. Where have you felt Him say “Here I am”?"
        },
        {
          "dow": "Wed",
          "scripture": "Isaiah 59:16, 20",
          "quote": "And the Redeemer shall come to Zion",
          "thought": "Jesus is the Intercessor who steps in when we can’t save ourselves. Thank Him for one way He has helped you."
        },
        {
          "dow": "Thu",
          "scripture": "Isaiah 60:1",
          "quote": "Arise, shine; for thy light is come",
          "thought": "Jesus and His gospel are a light that helps us find our way home. How can you shine it for someone today?"
        },
        {
          "dow": "Fri",
          "scripture": "Isaiah 61:1–3",
          "quote": "to give unto them beauty for ashes, the oil of joy for mourning",
          "thought": "Jesus read these words in Nazareth to say He is the Messiah (Luke 4:16–21). How has He given you beauty for ashes?"
        },
        {
          "dow": "Sat",
          "scripture": "Isaiah 65:17–18",
          "quote": "be ye glad and rejoice for ever in that which I create",
          "thought": "When the Savior comes again there will be peace and joy. What can we do today to get ready for Him?"
        },
        {
          "dow": "Sun",
          "scripture": "Isaiah 58:13–14",
          "quote": "call the sabbath a delight",
          "thought": "What would make today more of a delight for our family? Share one idea at dinner."
        }
      ],
      "daily_note": "Mon–Sun queue for the CFM week (week_of); the v3 dashboard shows the item whose dow matches the iPad's date. Replace on the Saturday refresh."
    },
